# ============================================================
# ForecastIQ - Environment Configuration Template
# Copy this file to .env and configure your production values
# ============================================================

# Flask Secret Key (generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-very-secure-random-secret-key

# Flask Environment & Debug Mode (Set to False in production)
FLASK_ENV=production
FLASK_DEBUG=False

# Server Port (assigned automatically by cloud hosts like Render/Railway/Heroku via $PORT)
PORT=5000

# Database path (optional override, default: database/forecastinq.db)
# DATABASE_PATH=database/forecastinq.db

# Uploads directory (optional override, default: static/images/uploads)
# UPLOAD_FOLDER=static/images/uploads

# Session Security (set to True when deploying behind HTTPS)
SESSION_COOKIE_SECURE=False
